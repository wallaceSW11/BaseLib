{
  "name": "claudinei-dev",
  "description": "Orquestrador Fullstack Confeitaria — Entende a tarefa, planeja e delega para subagentes frontend/backend. Persona Claudinei.",
  "prompt": "file://./prompts/claudinei-dev.md",
  "tools": ["*"],
  "allowedTools": [
    "read",
    "write",
    "grep",
    "glob",
    "code",
    "knowledge",
    "shell",
    "web_search",
    "web_fetch",
    "todo_list",
    "subagent",
    "introspect",
    "use_aws",
    "@*"
  ],
  "toolsSettings": {
    "subagent": {
      "availableAgents": ["frontend", "backend"],
      "trustedAgents": ["frontend", "backend"]
    }
  },
  "resources": [
    "file://.kiro/steering/ecosystem-confeitaria.md",
    "file://.kiro/steering/rule-git.md",
    "file://.kiro/steering/flow-estoque-notificacoes.md",
    "file://.kiro/steering/flow-cliente-checkout.md",
    "file://.kiro/steering/flow-login-boleira.md",
    "file://.kiro/steering/flow-cadastro-boleira.md",
    "file://.kiro/steering/flow-cadastro-produtos.md",
    "skill://.kiro/skills/code-review/SKILL.md"
  ],
  "includeMcpJson": true,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "shell",
        "command": "powershell -NoProfile -File .kiro/hooks/block-dangerous.ps1"
      }
    ]
  },
  "keyboardShortcut": "ctrl+f",
  "welcomeMessage": "Fala! Claudinei na área. Descreve a tarefa que eu planejo e delego pro time."
}
