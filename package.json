{
  "name": "@wallacesw11/base-lib",
  "version": "1.0.0",
  "description": "Reusable Vue 3 components and utilities library with TypeScript support",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/base-lib.css",
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/composables/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./stores": {
      "types": "./dist/stores/index.d.ts",
      "import": "./dist/stores/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "dev:playground": "vite --config playground/vite.config.ts",
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "build:playground": "vite build --config playground/vite.config.ts --outDir playground/dist",
    "prepublishOnly": "pnpm build",
    "lint": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "vue",
    "vue3",
    "typescript",
    "components",
    "library",
    "vuetify",
    "pinia"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wallaceSW11/BaseLib.git"
  },
  "bugs": {
    "url": "https://github.com/wallaceSW11/BaseLib/issues"
  },
  "homepage": "https://github.com/wallaceSW11/BaseLib#readme",
  "author": "wallaceSW11",
  "license": "MIT",
  "peerDependencies": {
    "axios": "^1.0.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vuetify": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdi/font": "^7.4.47",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "axios": "^1.13.5",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "jsdom": "^29.1.1",
    "pinia": "^3.0.4",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.0.18",
    "vue": "^3.5.28",
    "vue-eslint-parser": "^10.4.0",
    "vue-router": "^4.6.3",
    "vue-tsc": "^3.2.4",
    "vuetify": "^3.11.8"
  },
  "dependencies": {
    "maska": "^3.2.0"
  }
}
